rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isVerifiedAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && (
               request.auth.token.email == 'banglag215@gmail.com' || 
               request.auth.token.email == 'rkkhan205090@gmail.com'
             );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprints
    function isValidMessage(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.message is string && data.message.size() <= 5000 &&
             data.createdAt == request.time;
    }

    function isValidLog(data) {
      return data.action is string && data.action.size() <= 200 &&
             data.details is string && data.details.size() <= 2000 &&
             data.timestamp == request.time &&
             data.adminEmail is string;
    }

    function isValidSkill(data) {
      return data.name is string && data.name.size() <= 100 &&
             data.level is number && data.level >= 0 && data.level <= 100 &&
             data.order is number;
    }

    function isValidChallenge(data) {
      return data.target is string && data.target.size() <= 100 &&
             data.hint is string && data.hint.size() <= 500 &&
             data.limit is number && data.limit >= 1 &&
             data.order is number &&
             (data.difficulty == null || data.difficulty in ['easy', 'medium', 'hard', 'expert']);
    }

    function isValidVaultItem(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.type is string && data.type in ['text', 'image', 'link', 'file'] &&
             data.order is number;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Messages rules
    match /messages/{messageId} {
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow read, update, delete: if isVerifiedAdmin();
    }

    // Challenges rules
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if isVerifiedAdmin() && isValidChallenge(incoming());
      allow update: if isVerifiedAdmin() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['target', 'hint', 'limit', 'order']) && isValidChallenge(incoming())) ||
        isVerifiedAdmin()
      );
      allow delete: if isVerifiedAdmin();
    }

    // Vault rules
    match /vault/{itemId} {
      allow read: if true;
      allow create: if isVerifiedAdmin() && isValidVaultItem(incoming());
      allow update: if isVerifiedAdmin() && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'order']) && isValidVaultItem(incoming())) ||
        isVerifiedAdmin()
      );
      allow delete: if isVerifiedAdmin();
    }

    // Projects rules
    match /projects/{projectId} {
      allow list: if resource.data.status == 'published' || isVerifiedAdmin();
      allow get: if true;
      allow create: if isVerifiedAdmin();
      allow update: if isVerifiedAdmin();
      allow delete: if isVerifiedAdmin();
    }

    // Blog rules
    match /blog/{postId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // System settings rules
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Contact links rules
    match /contacts/{contactId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Skills rules
    match /skills/{skillId} {
      allow read: if true;
      allow create, update, delete: if isVerifiedAdmin();
    }

    // Analytics rules
    match /analytics/{logId} {
      allow create: if true;
      allow read, delete: if isVerifiedAdmin();
    }

    // Stats rules
    match /stats/{docId} {
      allow read: if true;
      allow update: if (
        incoming().diff(resource.data).affectedKeys().hasOnly(['totalVisits'])
      ) || isVerifiedAdmin();
      allow create, delete: if isVerifiedAdmin();
    }

    // System Logs rules
    match /logs/{logId} {
      allow create: if isVerifiedAdmin() && isValidId(logId) && isValidLog(incoming());
      allow list: if isVerifiedAdmin();
      allow get, update, delete: if isVerifiedAdmin();
    }
  }
}
